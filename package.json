{
  "name": "mcp-wales",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An open-source MCP server for trusted local and public data in Wales, starting with Cardiff.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run geography:verify && next build && node scripts/check-runtime-bundle.mjs",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:client": "node scripts/test-client.mjs",
    "test:smoke": "start-server-and-test start http://127.0.0.1:3000 smoke:client",
    "check": "npm run lint && npm run type-check && npm test && npm run test:maintenance && npm run build",
    "test:maintenance": "python3 scripts/test-source-freshness.py",
    "geography:verify": "node scripts/verify-geography.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "mcp-handler": "^2.3.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.15.8",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.0.0",
    "start-server-and-test": "^2.0.13",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^5.0.3"
  }
}
